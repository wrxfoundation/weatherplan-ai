# ─── AEOGEO 환경 변수 ───────────────────────────────
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
# .env.local 은 절대 git에 커밋하지 마세요.

# Anthropic API 키 (필수 아님 — 없으면 AI 총평·정밀 진단만 비활성)
# 발급: https://console.anthropic.com/
# 형식: sk-ant-api03-...
ANTHROPIC_API_KEY=

# ─── 이력·벤치마크 DB (Supabase — 선택) ───
# db/schema.sql 을 Supabase SQL Editor에서 실행한 뒤 아래 값 등록
# 없으면 점수 추이·벤치마크 백분위 기능만 비활성
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ─── 벤치마크 축적 관리자 토큰 (선택) ───
# /api/benchmark-run 호출 시 x-admin-token 헤더로 검증
ADMIN_TOKEN=

# ─── 주간 자동 재진단 (선택) ───
# 감시 호스트 쉼표 구분 (3~4개 권장 — 함수 60초 한도)
WATCH_HOSTS=
# Vercel Cron 인증 (설정 권장 — 아무 랜덤 문자열)
CRON_SECRET=
# 변동 알림 웹훅 (Slack/Discord incoming webhook URL)
ALERT_WEBHOOK_URL=
