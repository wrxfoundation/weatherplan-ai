{
  "version": 2,
  "framework": "nextjs",
  "regions": ["icn1"],
  "functions": {
    "pages/api/scorecard.js": {
      "maxDuration": 30
    },
    "pages/api/deep-scan.js": {
      "maxDuration": 60
    },
    "pages/api/insight.js": {
      "maxDuration": 30
    },
    "pages/api/benchmark-run.js": {
      "maxDuration": 60
    },
    "pages/api/cron-rescan.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron-rescan", "schedule": "0 0 * * 1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
