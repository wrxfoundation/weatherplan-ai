# =============================================================================
# Weather Plan AI · 환경변수 가이드
# =============================================================================
# 이 파일을 .env.local로 복사한 뒤 실제 키 값으로 채워주세요:
#   cp .env.local.example .env.local
#
# Vercel에 배포 시에는 Vercel Dashboard > Settings > Environment Variables에서 등록.
# .env.local은 .gitignore에 의해 Git에 커밋되지 않습니다.
# =============================================================================

# ─── 필수 ─────────────────────────────────────────────────────────────────────

# Anthropic Claude API 키 (Studio · AgencyBoard 챗봇용)
# 발급: https://console.anthropic.com/settings/keys
# 형식: sk-ant-api03-...
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXX

# ─── 선택 ─────────────────────────────────────────────────────────────────────

# Kakao JavaScript SDK 키 (AgencyBoard 일간 보고 카톡 공유용)
# 발급: https://developers.kakao.com/console/app > 앱 설정 > 앱 키 > JavaScript 키
# NEXT_PUBLIC_ 접두사가 붙은 환경변수는 브라우저에 노출됩니다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# 운영 환경 식별 (개발/스테이징/프로덕션 분기에 사용 가능)
NODE_ENV=development
