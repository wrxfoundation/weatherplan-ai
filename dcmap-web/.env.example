# 서버리스 함수용 (Vercel 프로젝트 환경변수에 설정 — 실제 키는 절대 커밋 금지)

# 케이웨더 기상 OpenAPI 키 (KW_기상API_OpenAPI 가이드 기준)
KWEATHER_API_KEY=
# 게이트웨이 베이스 오버라이드 (선택, 기본 https://gateway.kweather.co.kr/weather/w3/v2/kw-sensors)
KWEATHER_API_BASE=

# vworld 오픈API 키 (www.vworld.kr 발급) — 지번주소(/api/revgeo)·용도지역(/api/landuse)·계통코드 조회
VWORLD_KEY=

# 한전 전력데이터 개방포털 키 (bigdata.kepco.co.kr) — /api/headroom 분산전원 계통 여유용량
KEPCO_API_KEY=
# 분산전원연계 엔드포인트 템플릿 오버라이드 (선택). {sido} {sigungu} {key} 플레이스홀더 — 포털 실제 경로 확정 시 수정
KEPCO_HEADROOM_URL=

# DART 전자공시 오픈API 키 (opendart.fss.or.kr) — D2 이벤트 어댑터(사업자 DC 투자·착공 공시) 대상, 런타임 미사용
DART_API_KEY=

# 프리렌더 canonical/sitemap 오리진
VITE_SITE_ORIGIN=https://myeongdang-ai-sand.vercel.app
