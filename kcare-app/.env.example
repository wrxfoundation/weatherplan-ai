# K-CARE 환경변수 — 실제 값은 .env.local(로컬) 또는 Vercel 환경변수에 넣고 git 에 올리지 않는다.
# 전부 선택이다. 없으면 해당 기능이 '설정 전' 안내로 바뀌고 화면은 그대로 동작한다.

# ── 구글 로그인 (lib/auth-server.js · DEPLOY.md 3~4단계) ──
# Google Cloud 콘솔 > Google Auth Platform > Clients > 웹 애플리케이션 클라이언트
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 세션 서명용 임의 문자열 — 터미널에서 `openssl rand -base64 32` 로 만든다
NEXTAUTH_SECRET=
# 운영 주소 (끝에 / 없이). 로컬은 http://localhost:3100
NEXTAUTH_URL=
# 베타 잠금 — "1" 이면 로그인해야 화면이 열린다 (서비스 소개·결제·로그인 화면은 공개)
BETA_REQUIRE_LOGIN=
# 로그인 허용 계정 — 쉼표로 여러 개. 둘 다 비우면 구글 콘솔 테스트 사용자 누구나
BETA_ALLOWED_EMAILS=
BETA_ALLOWED_DOMAINS=

# ── AI 도우미 (pages/api/ai.js) — 없으면 기록 기반 데모 답변 ──
ANTHROPIC_API_KEY=

# ── 토스페이먼츠 결제 (docs/toss-payments.md) ──
# 값은 토스페이먼츠 개발자센터 > 내 개발정보에서 발급한다.
#
# 클라이언트 키: 브라우저에 그대로 나간다 (공개 전제). 결제창을 여는 데 쓴다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# 시크릿 키: 서버에서만 읽는다. 결제 승인·빌링키 발급에 쓰며 절대 노출하지 않는다.
# 이 값이 없으면 결제 화면이 '키 미설정' 안내를 띄우고 승인 API 는 503 을 돌려준다.
TOSS_SECRET_KEY=
