# K-CARE 환경변수 — 실제 값은 .env.local(로컬) 또는 Vercel 환경변수에 넣고 git 에 올리지 않는다.
# 전부 선택이다. 없으면 해당 기능이 '설정 전' 안내로 바뀌고 화면은 그대로(데모로) 동작한다.

# ── 로그인 공통 (lib/auth-server.js · DEPLOY.md 3단계) ──
# 세션 서명용 임의 문자열 — 터미널에서 `openssl rand -base64 32` 로 만든다
NEXTAUTH_SECRET=

# ── 테스트 계정 로그인 (lib/test-accounts.js · DEPLOY.md 3단계) ──
# 테스트 계정 세 개(보호자·어르신·컨시어지)가 같이 쓰는 비밀번호. 12자 이상으로.
# NEXTAUTH_SECRET 과 이 값이 있으면 로그인 화면에 테스트 아이디가 켜지고,
# 구글 키가 없는 동안 'Google 계정으로 계속하기'는 시뮬레이션으로 간다.
BETA_TEST_PASSWORD=

# ── 서버 저장 · Supabase (lib/db.js · supabase/schema.sql · DEPLOY.md 4단계) ──
# 테스트 계정으로 로그인했을 때 기록이 여기 쌓인다. 없으면 이 기기에만 저장된다.
# Supabase 대시보드 위쪽 Connect 버튼 → Project URL (https://xxxx.supabase.co)
SUPABASE_URL=
# Supabase 대시보드 > Project Settings > API Keys > Secret keys (sb_secret_…) — 서버 전용
# (예전 방식의 service_role 키를 SUPABASE_SERVICE_ROLE_KEY 로 넣어도 된다)
SUPABASE_SECRET_KEY=

# ── 구글 로그인 (DEPLOY.md 5단계 · 나중에) ──
# Google Cloud 콘솔 > Google Auth Platform > Clients > 웹 애플리케이션 클라이언트
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 운영 주소 (끝에 / 없이). 로컬은 http://localhost:3100
NEXTAUTH_URL=

# ── 베타 잠금 (middleware.js · DEPLOY.md 7단계) ──
# "1" 이면 로그인해야 화면이 열린다 (서비스 소개·결제·로그인 화면은 공개)
BETA_REQUIRE_LOGIN=
# 구글 로그인 허용 계정 — 쉼표로 여러 개. 둘 다 비우면 구글 콘솔 테스트 사용자 누구나
BETA_ALLOWED_EMAILS=
BETA_ALLOWED_DOMAINS=

# ── AI 도우미 (pages/api/ai.js) — 없으면 기록 기반 데모 답변 ──
ANTHROPIC_API_KEY=

# ── 토스페이먼츠 결제 (docs/toss-payments.md) ──
# 값은 토스페이먼츠 개발자센터 > 내 개발정보에서 발급한다.
#
# 클라이언트 키: 브라우저에 그대로 나간다 (공개 전제). 결제창을 여는 데 쓴다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# 시크릿 키: 서버에서만 읽는다. 결제 승인·빌링키 발급에 쓰며 절대 노출하지 않는다.
# 이 값이 없으면 결제 화면이 '키 미설정' 안내를 띄우고 승인 API 는 503 을 돌려준다.
TOSS_SECRET_KEY=
