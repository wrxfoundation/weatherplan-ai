# server/.env 로 복사해서 채우세요. 이 파일(.env)은 절대 커밋하지 않습니다.

# BotFather에서 발급한 봇 토큰. 봇을 채널·그룹의 "관리자"로 추가해야 합니다.
TELEGRAM_BOT_TOKEN=

# 공지 채널 / 대화방(그룹) 식별자.
# @채널명(공개 채널) 또는 -100으로 시작하는 숫자 ID(비공개) 둘 다 가능합니다.
TELEGRAM_CHANNEL_ID=@your_channel
TELEGRAM_GROUP_ID=

# (선택) 웹훅용 공개 URL — 없으면 폴링 수집만 동작합니다.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# X는 개별 관계 조회가 엔터프라이즈 전용이라 자동 수집 대상이 아닙니다.
# 팔로워 수만 수동으로 넣고 싶을 때 사용합니다(선택).
X_FOLLOWERS_MANUAL=
