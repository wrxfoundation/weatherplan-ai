+@media (prefers-reduced-motion: reduce) { .rf-btn.shine::after { animation: none; display: none; } }
+.rf-hero-cap { position: absolute; right: clamp(16px, 4vw, 40px); bottom: 12px; z-index: 2; font-size: 11.5px; font-weight: 700; letter-spacing: .06em; color: rgba(255,255,255,.62); }
+@media (max-width: 920px) {
