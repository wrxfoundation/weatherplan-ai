+.rf-btn.fill:disabled { background: rgba(255,255,255,.14); color: rgba(255,255,255,.66); border: 1px solid rgba(255,255,255,.26); box-shadow: none; cursor: not-allowed; transform: none; }
+.rf-btn.done { background: #16a34a; border-color: #16a34a; }
+.rf-btn.ghost { background: rgba(255,255,255,.06); color: #fff; border-color: rgba(255,255,255,.36); }
+.rf-btn.ghost:hover { background: rgba(255,255,255,.14); }
+/* 참여 유도 - 빛띠 스윕 하나만 (2026-09-19 지시: 효과는 한 가지만) */
+.rf-btn.shine { position: relative; overflow: hidden; }
+.rf-btn.shine::after {
+  content: ""; position: absolute; top: -60%; bottom: -60%; left: -80%; width: 45%;
+  background: linear-gradient(105deg, rgba(255,255,255,0) 0%, rgba(255,255,255,.7) 50%, rgba(255,255,255,0) 100%);
