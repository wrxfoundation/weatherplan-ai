+.rf-hero-cta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 26px; }
+.rf-hero-sub { margin: 12px 0 0; font-size: 14px; color: #c9c3ee; font-weight: 600; }
+.rf-hero-cd { font-family: var(--rf-sans); font-size: 14.5px; font-weight: 700; color: #c8c8f0; font-variant-numeric: tabular-nums; }
+.rf-hero-link {
