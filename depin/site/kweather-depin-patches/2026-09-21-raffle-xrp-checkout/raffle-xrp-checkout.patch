+  return { M: d.getUTCMonth() + 1, D: d.getUTCDate(), wd: d.getUTCDay(), hm: `${String(d.getUTCHours()).padStart(2, "0")}:${String(d.getUTCMinutes()).padStart(2, "0")}` };
