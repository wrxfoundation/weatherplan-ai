+  .rf-hero-cap { position: static; display: block; text-align: center; padding: 8px 0 12px; }
+}
+@media (max-width: 640px) {
+  .rf-hero-grid { padding-top: 28px; padding-bottom: 4px; }
+  .rf-hero h1 { font-size: 30px; }
+  .rf-hero-lead br { display: none; }
