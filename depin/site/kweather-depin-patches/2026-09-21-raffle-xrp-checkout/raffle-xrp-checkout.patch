+  .rf-hero-grid { grid-template-columns: minmax(0, 1fr); padding-top: clamp(34px, 8vw, 56px); padding-bottom: 8px; }
+  .rf-hero-cap { position: static; display: block; text-align: center; padding: 8px 0 12px; }
