+/** "9.22(화)" · "18:00" */
+export const fmtDay = (iso: string | undefined, lang: Lang) => { const p = kstParts(iso); return p ? `${p.M}.${String(p.D).padStart(2, "0")}(${WD[lang][p.wd]})` : ""; };
+export const fmtHm = (iso: string | undefined) => kstParts(iso)?.hm ?? "";
