# 배포 도메인 — 프리렌더 canonical·sitemap·llms.txt·JSON-LD의 절대 URL 기준
VITE_SITE_ORIGIN=https://yokaimap.kr

# vworld 지도(국토교통부 브이월드) 도메인 등록키 — 한글 기본도·위성 타일용.
# 브라우저에 노출되는 키이며 Referer(도메인) 검증으로 보호된다. 미설정 시 다크 타일만 노출.
VITE_VWORLD_KEY=

# 케이웨더 Air365 게이트웨이 키 — /api/weather 서버리스 함수 전용(브라우저 노출 금지).
# 미설정 시 날씨 위젯은 available:false로 정직하게 비활성화된다.
KWEATHER_API_KEY=
KWEATHER_API_BASE=https://gateway.kweather.co.kr:8443
