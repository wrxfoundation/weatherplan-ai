# --- LLM (extraction / translation / verification) ---
ANTHROPIC_API_KEY=

# --- Sources (official APIs first; scraping is last-resort) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=

# --- Government sources (dormant: set the key -> the adapter self-activates on the next pull) ---
TOURAPI_KEY=                       # 한국관광공사 KTO (place/festival)   — data.go.kr serviceKey
KOSIS_API_KEY=                     # 국가통계포털 KOSIS (region population) — kosis.kr OpenAPI key
HERITAGE_API_KEY=                  # 국가유산청 KHS (heritage designation) — data.go.kr serviceKey [Tier B #1]
MEDICAL_API_KEY=                   # 심평원 HIRA (hospital registry)      — data.go.kr serviceKey [Tier B]
DART_API_KEY=                      # 금융감독원 전자공시 DART (company)    — opendart.fss.or.kr crtfc_key [Tier B]

# --- Tier C sources (RAWG dormant; TheSportsDB/AniList/Wiktionary are keyless always-on) ---
RAWG_API_KEY=                      # RAWG (game 3rd source) — free key at rawg.io/apidocs [Tier C]
SPORTSDB_API_KEY=                  # TheSportsDB override; blank -> free public test key "3" (keyless) [Tier C]

# --- Append-only store ---
KOREAAPI_DB=koreaapi.db            # dev SQLite path (default); used by admin / pull / export
DATABASE_URL=                      # Postgres (production scale); same insert-only contract

# --- Commerce rails (engine 1; cold-start optional; commission is a later switch) ---
SKIMLINKS_PUBLISHER_ID=
AMAZON_ASSOCIATES_TAG=

# --- Trend digest (engine 2; "Korea Rising" newsletter) ---
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# --- Phase 2: agent payments (x402 / USDC) — wire only when traffic qualifies ---
CDP_API_KEY_ID=                    # Coinbase Developer Platform (x402 facilitator)
CDP_API_KEY_SECRET=
KOREAAPI_PAYOUT_ADDRESS=           # USDC receiving address (Base). Not "receive BNB"; no token.

# --- Accounts & keys shopping list: docs/API_KEYS.md ---

# --- Collection cadence (seconds; see src/koreaapi/pipeline/scheduler.py) ---
CADENCE_CHARTS_SEC=43200
CADENCE_EVENTS_SEC=86400

LOG_LEVEL=INFO
